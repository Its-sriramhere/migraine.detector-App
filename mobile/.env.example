# Copy to .env and adjust. Never commit .env (it may hold LAN IPs).
#
# Android emulator:  http://10.0.2.2:8000/api   (10.0.2.2 = host loopback alias)
# iOS simulator:     http://localhost:8000/api
# Physical device:   http://<your-LAN-IP>:8000/api  (e.g. http://192.168.1.7:8000/api)
#
# Restart Metro after changing this file (env vars are inlined at bundle time):
#   npx expo start --clear
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api
