{
  "expo": {
    "name": "Migraine Detector Beta",
    "slug": "migraine-detector",
    "scheme": "migrainedetector",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand-icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "The wearable streams your sleep, HRV, blood pressure and SpO2 readings to the app and receives risk alerts.",
        "NSBluetoothPeripheralUsageDescription": "The wearable streams your sleep, HRV, blood pressure and SpO2 readings to the app and receives risk alerts."
      }
    },
    "android": {
      "package": "com.migrainedetector.beta",
      "versionCode": 1,
      "version": "1.0.0-beta.1",
      "adaptiveIcon": {
        "backgroundColor": "#F8FBFF",
        "foregroundImage": "./assets/brand-adaptive.png",
        "monochromeImage": "./assets/brand-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "./plugins/withReleaseSigning",
      "./plugins/withBondedDevices",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "neverForLocation": true
        }
      ]
    ]
  }
}
