# Migraine Detector backend — environment template.
# Copy to backend/.env and fill in. Never commit the real .env.

# --- Database -------------------------------------------------------------
# Supabase Postgres. Two host styles exist:
#
#   Direct  : db.<project-ref>.supabase.co        (IPv6-only A record)
#   Pooler  : aws-0-<region>.pooler.supabase.com  (IPv4, use this one)
#
# The direct host only publishes an AAAA record, so it does not resolve on
# IPv4-only networks and fails with "could not translate host name".
#
# The pooler uses a different username: postgres.<project-ref>
# and the password must be URL-encoded, so "@" becomes "%40".
#
#   postgresql://postgres.<ref>:<encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# For local development only, a file-backed database also works:
#   sqlite:///./migraine.db
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Supabase -------------------------------------------------------------
# Used for Storage mirroring of the bundled datasets. The service role key is
# optional: without it the API still runs, only the Storage upload is skipped.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=datasets

# --- Auth -----------------------------------------------------------------
# Long random string used to sign JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=43200
# Reserved accounts provisioned by CLI. These addresses cannot self-register.
DEVELOPER_EMAILS=developer@migraine.example.com

# --- CORS -----------------------------------------------------------------
# Comma-separated list of allowed origins for browser clients. The native
# Android app is not subject to CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-api.onrender.com

# --- Mira assistant -------------------------------------------------------
# Optional. When empty, Mira answers from the built-in app guide and wellness
# FAQ. When set, open-ended questions are forwarded to the model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Notifications --------------------------------------------------------
# SMS is mock-only: alerts are recorded in notification_logs, nothing is sent.
SMS_ENABLED=false
SMS_PROVIDER=mock
SMS_MAX_SENDS=5

# --- Model ----------------------------------------------------------------
DEFAULT_PREDICTION_WINDOW_MINUTES=60
DEMO_INTERVAL_SECONDS=2.5
EXPORT_MAX_ROWS=10000
